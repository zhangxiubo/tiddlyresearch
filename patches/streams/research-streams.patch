diff --git a/plugins/streams/draft_structure.js b/plugins/streams/draft_structure.js
new file mode 100644
index 0000000..2fae5b8
--- /dev/null
+++ b/plugins/streams/draft_structure.js
@@ -0,0 +1,32 @@
+/*\
+title: $:/plugins/sq/streams/draft_structure.js
+type: application/javascript
+module-type: library
+\*/
+(function(){
+"use strict";
+
+var structure_fields = ["parent","stream-list","stream-type"];
+
+exports.capture = function(draft) {
+	var baseline = {};
+	structure_fields.forEach(function(field) {
+		baseline[field] = draft.getFieldString(field);
+	});
+	return new $tw.Tiddler(draft,{"draft.streams": JSON.stringify(baseline)});
+};
+
+exports.merge = function(wiki,saved,draft) {
+	var fields = {"draft.streams": undefined},
+		baseline = $tw.utils.parseJSONSafe(draft.fields["draft.streams"],null),
+		current = wiki.getTiddler(draft.fields["draft.of"]);
+	if(baseline && current) {
+		structure_fields.forEach(function(field) {
+			if(draft.getFieldString(field) === baseline[field]) {
+				fields[field] = current.fields[field];
+			}
+		});
+	}
+	return new $tw.Tiddler(saved,fields);
+};
+})();
diff --git a/plugins/streams/filters/stream_ancestors.js b/plugins/streams/filters/stream_ancestors.js
new file mode 100644
index 0000000..ad76ae0
--- /dev/null
+++ b/plugins/streams/filters/stream_ancestors.js
@@ -0,0 +1,24 @@
+/*\
+title: $:/plugins/sq/streams/filters/stream_ancestors.js
+type: application/javascript
+module-type: filteroperator
+\*/
+(function(){
+"use strict";
+
+exports.stream_ancestors = function(source,operator,options) {
+	var results = [];
+	source(function(tiddler,title) {
+		var ancestors = [],
+			visited = new Set([title]),
+			parent = tiddler && options.wiki.getTiddler(tiddler.fields.parent);
+		while(parent && !visited.has(parent.fields.title)) {
+			visited.add(parent.fields.title);
+			ancestors.unshift(parent.fields.title);
+			parent = options.wiki.getTiddler(parent.fields.parent);
+		}
+		$tw.utils.pushTop(results,ancestors);
+	});
+	return results;
+};
+})();
diff --git a/plugins/streams/fork_notes.tid b/plugins/streams/fork_notes.tid
new file mode 100644
index 0000000..eb7057b
--- /dev/null
+++ b/plugins/streams/fork_notes.tid
@@ -0,0 +1,17 @@
+title: $:/plugins/sq/streams/fork_notes
+
+! Research fork 1.3.0
+
+Based on upstream Streams 1.2.24, commit 17dfc9cf634338f986acc99413113884cfaba2a0. The plugin keeps its existing title and node fields, and replaces the upstream plugin when installed.
+
+* Uses current event attributes and supports server-side rendering without browser swipe APIs.
+* The outline and editable node previews share one interaction template, including context menus, keyboard actions and swipe handling.
+* `templates/node_preview` renders the current node and its children with editing controls.
+* `templates/breadcrumbs` renders ancestors using the configurable `$:/config/sq/streams/breadcrumb_template`. Traversal stops at missing parents and repeated nodes.
+* `$:/config/sq/streams/node_tags_filter` supplies the values for node styling.
+* Tiddlers tagged `$:/tags/streams/row_decorations` add content beside each row without replacing the row template.
+* `$:/config/sq/streams/enable_edit_mode` enables outlines in the core editor through `$:/tags/EditTemplate`.
+
+When edit-mode integration is enabled, new drafts capture their initial structural fields. Saving keeps later node moves and child-list updates when those fields were not explicitly edited in the draft. Explicit draft field edits take precedence. Draft bookkeeping is removed on save. Drafts created before installing this version have no baseline and retain the core's save behavior.
+
+The supported acceptance-test target for this fork is TiddlyWiki 5.4.1 with Relink 2.6.1. The research presentation choices belong in the separate Research customizations plugin.
